rules_version = '2';
/* Each signed-in person can read and write only the documents under users/{their uid}.
   This project is for the Clay Jar Treasure Bible (bibleId "ctb"). There is no public data here.
   Spark plan: these rules run in Firestore. No Cloud Functions.
   App Check is not required here until the owner turns it on in the Firebase console.
   Requiring request.app before that would block every sign-in. */
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function knownBible(bibleId) {
      return bibleId == 'ctb' || bibleId == 'cjt';
    }

    match /users/{uid} {
      allow read, delete: if signedIn(uid);
      allow create, update: if signedIn(uid)
        && request.resource.data.keys().hasOnly(['createdAt', 'updatedAt'])
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.size() < 2000;

      match /bibles/{bibleId} {
        allow read, delete: if signedIn(uid) && knownBible(bibleId);
        allow create, update: if signedIn(uid)
          && knownBible(bibleId)
          && request.resource.data.schema == 1
          && request.resource.data.keys().hasOnly(['schema', 'reading', 'audio', 'audioSettings'])
          && request.resource.size() < 20000;

        match /bookmarks/{itemId} {
          allow read, delete: if signedIn(uid) && knownBible(bibleId);
          allow create, update: if signedIn(uid) && knownBible(bibleId) && validItem(itemId);
        }
        match /highlights/{itemId} {
          allow read, delete: if signedIn(uid) && knownBible(bibleId);
          allow create, update: if signedIn(uid) && knownBible(bibleId) && validItem(itemId);
        }
      }
    }

    function validItem(itemId) {
      return request.resource.data.id == itemId
        && request.resource.data.keys().hasAll(['id', 't'])
        && request.resource.data.keys().size() < 16
        && request.resource.data.id is string
        && request.resource.data.id.size() > 0
        && request.resource.data.id.size() < 80
        && request.resource.data.t is number
        && request.resource.size() < 16000
        && (!('text' in request.resource.data)
            || (request.resource.data.text is string && request.resource.data.text.size() <= 4000))
        && (!('book' in request.resource.data)
            || (request.resource.data.book is string && request.resource.data.book.size() < 80))
        && (!('name' in request.resource.data)
            || (request.resource.data.name is string && request.resource.data.name.size() < 80))
        && (!('ch' in request.resource.data)
            || (request.resource.data.ch is int && request.resource.data.ch >= 0 && request.resource.data.ch < 1000))
        && (!('v' in request.resource.data)
            || (request.resource.data.v is int && request.resource.data.v >= 0 && request.resource.data.v < 1000))
        && (!('color' in request.resource.data)
            || request.resource.data.color in ['yellow', 'green', 'blue', 'pink', ''])
        && (!('deleted' in request.resource.data)
            || request.resource.data.deleted is bool)
        && (!('whole' in request.resource.data)
            || request.resource.data.whole is bool)
        && (!('s' in request.resource.data)
            || (request.resource.data.s is int && request.resource.data.s >= 0 && request.resource.data.s < 100000))
        && (!('e' in request.resource.data)
            || (request.resource.data.e is int && request.resource.data.e >= 0 && request.resource.data.e < 100000));
    }
  }
}
